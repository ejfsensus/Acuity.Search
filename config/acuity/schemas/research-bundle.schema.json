{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://acuity.institute/schemas/acuity.research-bundle.v1.1.json",
  "title": "Acuity.Search research bundle (v1 / v1.1)",
  "description": "Matches lib/acuity/export/index.ts exportRunToResearchBundle. v1.1 adds sources[].snippet/accessStatus, answer.citations, coverage and provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleId",
    "exportedAt",
    "sourceProduct",
    "queryRun",
    "sources",
    "evidence",
    "codexCandidates",
    "integrity"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "acuity.research-bundle.v1",
        "acuity.research-bundle.v1.1",
        "acuity.research-bundle.v1.2"
      ]
    },
    "exampleOnly": {
      "type": "boolean"
    },
    "bundleId": {
      "type": "string"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "Acuity.Search"
        },
        "version": {
          "type": "string"
        },
        "gitCommit": {
          "type": "string"
        }
      }
    },
    "queryRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "query",
        "discoveryMode",
        "depth",
        "scope",
        "executedQueries"
      ],
      "properties": {
        "runId": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "discoveryMode": {
          "type": "string",
          "enum": ["general", "literature", "collections", "sacred-texts"]
        },
        "depth": {
          "type": "string",
          "enum": ["quick", "research"]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "includeDomains", "excludeDomains"],
          "properties": {
            "policy": {
              "type": "string",
              "enum": ["strict", "open", "collection-and-web-lanes"]
            },
            "collectionGroupIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "entryIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "includeDomains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "excludeDomains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "executedQueries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "query", "status"],
            "properties": {
              "provider": {
                "type": "string",
                "enum": ["searxng", "brave", "tavily", "exa", "acuity-agent"]
              },
              "query": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "engines": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answerVersionId", "createdAt", "model", "markdown"],
      "properties": {
        "answerVersionId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "model": {
          "type": ["string", "null"]
        },
        "markdown": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "disclosureNote": {
          "type": "string"
        },
        "citations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceId", "evidenceIds"],
            "properties": {
              "sourceId": {
                "type": "string"
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "unresolvedLabels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "citationLabel",
          "title",
          "url",
          "domain",
          "providers",
          "contentState"
        ],
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "citationLabel": {
            "type": "string",
            "pattern": "^S\\d+$"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "canonicalUrl": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["searxng", "brave", "tavily", "exa", "acuity-agent"]
            }
          },
          "contentState": {
            "type": "string",
            "enum": [
              "snippet",
              "fulltext-excerpt",
              "catalogue-metadata",
              "scan-no-text",
              "unavailable"
            ]
          },
          "publishedDate": {
            "type": "string"
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "translators": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "editionOrYear": {
            "type": "string"
          },
          "snippet": {
            "type": "string"
          },
          "accessStatus": {
            "type": "string"
          },
          "literatureFormat": {
            "type": "string"
          },
          "workTitle": {
            "type": "string"
          },
          "passageId": {
            "type": "string"
          },
          "passageRef": {
            "type": "string"
          },
          "tradition": {
            "type": "string"
          },
          "bookCode": {
            "type": "string"
          },
          "licence": {
            "type": "string"
          },
          "origin": {
            "enum": ["sacred-text-index", "local-corpus"]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidenceId",
          "sourceId",
          "url",
          "verbatimText",
          "sha256",
          "contentState",
          "locator",
          "extractedAt"
        ],
        "properties": {
          "evidenceId": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "verbatimText": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "contentState": {
            "type": "string",
            "enum": [
              "snippet",
              "fulltext-excerpt",
              "catalogue-metadata",
              "scan-no-text",
              "unavailable"
            ]
          },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value"],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "css-heading",
                  "pdf-page",
                  "epub-chapter",
                  "char-offset"
                ]
              },
              "value": {
                "type": "string"
              }
            }
          },
          "extractedAt": {
            "type": "string"
          },
          "verbatim": {
            "type": "boolean"
          }
        }
      }
    },
    "codexCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidateType",
          "title",
          "summary",
          "sourceIds",
          "evidenceIds",
          "tags"
        ],
        "properties": {
          "candidateType": {
            "type": "string",
            "enum": ["source", "passage", "question", "tradition-note"]
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerStatuses",
        "searchedTargetHosts",
        "unsearchedTargetHosts",
        "limitations"
      ],
      "properties": {
        "providerStatuses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "status"],
            "properties": {
              "provider": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            }
          }
        },
        "searchedTargetHosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsearchedTargetHosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "generatedContentIsPrimarySource",
        "upstreamRunId"
      ],
      "properties": {
        "product": {
          "const": "Acuity.Search"
        },
        "generatedContentIsPrimarySource": {
          "const": false
        },
        "upstreamRunId": {
          "type": "string"
        },
        "delegate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["product", "chatId"],
          "properties": {
            "product": {
              "const": "Acuity.Agent"
            },
            "chatId": {
              "type": "null"
            }
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestEntries"],
      "properties": {
        "manifestEntries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
