{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "acuity.search.domains.v1"
    },
    "createdAt": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "const": "planning-seed-not-runtime-validation"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["file", "sha256", "note"]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "const": 110
        },
        "groups": {
          "const": 10
        },
        "uniqueUrls": {
          "const": 146
        },
        "uniqueHostsWithoutWww": {
          "const": 117
        }
      },
      "required": ["entries", "groups", "uniqueUrls", "uniqueHostsWithoutWww"]
    },
    "matchingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultScope": {
          "const": "selected-targets-only"
        },
        "hostMatch": {
          "const": "exact-host-or-explicit-www-alias"
        },
        "subdomains": {
          "const": "explicit-only"
        },
        "paths": {
          "const": "segment-aware-normalized-prefix"
        },
        "expansion": {
          "const": "explicit-user-action"
        }
      },
      "required": [
        "defaultScope",
        "hostMatch",
        "subdomains",
        "paths",
        "expansion"
      ]
    },
    "groups": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "suppliedTitle": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": ["id", "title", "suppliedTitle", "tags", "sourceIds"]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 110,
      "maxItems": 110,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^src-[0-9]{3}$"
          },
          "suppliedNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 110
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "groupIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "suppliedUrls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "hostname": {
                  "type": "string",
                  "pattern": "^[a-z0-9.-]+$"
                },
                "includeWwwAlias": {
                  "type": "boolean"
                },
                "includeOtherSubdomains": {
                  "const": false
                },
                "pathPrefix": {
                  "type": "string",
                  "pattern": "^/"
                },
                "seedUrl": {
                  "type": "string",
                  "format": "uri"
                },
                "referenceUrls": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              },
              "required": [
                "hostname",
                "includeWwwAlias",
                "includeOtherSubdomains",
                "pathPrefix",
                "seedUrl",
                "referenceUrls"
              ]
            }
          },
          "starterPriority": {
            "type": "boolean"
          },
          "discoveryRoles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "suppliedDescription": {
            "type": "string",
            "minLength": 1
          },
          "suppliedStrength": {
            "type": "string",
            "minLength": 1
          },
          "suppliedAccessModel": {
            "type": "string",
            "minLength": 1
          },
          "curation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "const": "imported-unverified"
              },
              "checkedAt": {
                "type": "null"
              },
              "claimsVerified": {
                "const": false
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": ["status", "checkedAt", "claimsVerified", "notes"]
          }
        },
        "required": [
          "id",
          "suppliedNumber",
          "title",
          "groupIds",
          "tags",
          "suppliedUrls",
          "targets",
          "starterPriority",
          "discoveryRoles",
          "suppliedDescription",
          "suppliedStrength",
          "suppliedAccessModel",
          "curation"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "createdAt",
    "status",
    "provenance",
    "counts",
    "matchingPolicy",
    "groups",
    "sources"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:acuity:search:domain-seed:v1",
  "title": "Acuity.Search planning seed registry; not runtime validation"
}
