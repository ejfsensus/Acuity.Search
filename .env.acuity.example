# =============================================================================
# Acuity.Search — Environment Configuration (.env.acuity.example)
# =============================================================================
# Separates existing upstream Morphic environment variables from Acuity.Search
# federation, discovery, LLM abstraction, and operational variables.
# Never commit real API keys or secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Existing Upstream Morphic Variables
# -----------------------------------------------------------------------------

# Database & Cache
DATABASE_URL=postgresql://acuity:acuity_local_password@localhost:5432/acuity_search
DATABASE_RESTRICTED_URL=postgresql://acuity_app:acuity_app_password@localhost:5432/acuity_search
REDIS_URL=redis://localhost:6379

# Search Providers (All 4 participate when enabled and configured)
# External SearXNG instance URL (Required for SearXNG adapter; never bundled)
# External SearXNG origin. SEARXNG_URL is accepted as an alias.
# Acuity's instance: https://searxng-production-3588.up.railway.app
# It must allow format=json (see docs/SEARXNG.md). If JSON is forbidden (403),
# Acuity falls back to parsing the HTML results page and, after repeated
# failures, skips SearXNG for 5 minutes instead of degrading every run.
SEARXNG_API_URL=https://searxng-production-3588.up.railway.app
SEARXNG_SAFESEARCH=0
SEARXNG_DEFAULT_DEPTH=basic
SEARXNG_ENGINES=
SEARXNG_TIME_RANGE=

# Commercial / API Search Providers (Optional; missing keys are disclosed in UI)
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=

# Legacy single-provider fallback selector (superseded by Acuity federation)
SEARCH_API=searxng

# Authentication & Session Security
AUTH_PROVIDER=better-auth
ENABLE_AUTH=true
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ENABLE_GUEST_CHAT=true
ENABLE_SHARE=true

# Privacy & Outbound Controls (Acuity defaults: disabled)
FAVICON_PROVIDER_URL=off
MORPHIC_UPDATE_CHECK_DISABLED=true
FETCH_ALLOW_PRIVATE_NETWORK=false
ENABLE_TRACING=false
NEXT_PUBLIC_POSTHOG_KEY=

# Upstream LLM Provider Keys (Optional; leave blank when LLM is unconfigured)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_API_BASE_URL=
OLLAMA_BASE_URL=
AI_GATEWAY_API_KEY=

# -----------------------------------------------------------------------------
# 2. Acuity.Search Product & Federation Variables
# -----------------------------------------------------------------------------

# Default discovery profile
ACUITY_SEARCH_DEFAULT_MODE=general
ACUITY_SEARCH_DEFAULT_DEPTH=quick
ACUITY_SEARCH_DEFAULT_PROVIDERS=searxng,brave,tavily,exa
ACUITY_SEARCH_ALLOW_RESULTS_ONLY=true

# Domain Registry paths
ACUITY_SEARCH_REGISTRY_SEED_PATH=config/acuity/domain-registry.seed.json
ACUITY_SEARCH_REGISTRY_PATH=config/acuity/domain-registry.json

# External SearXNG Gateway Authentication & Timeouts (Server-only)
ACUITY_SEARCH_SEARXNG_TIMEOUT_MS=8000
ACUITY_SEARCH_SEARXNG_AUTH_HEADER=
ACUITY_SEARCH_SEARXNG_AUTH_VALUE=

# Extraction & Evidence Bounds
ACUITY_SEARCH_EXTRACTION_MAX_BYTES=10485760
ACUITY_SEARCH_EXTRACTION_TIMEOUT_MS=10000
ACUITY_SEARCH_PDF_MAX_PAGES=40

# Provider-Neutral LLM Abstraction
# Values: unconfigured | openai-compatible | anthropic | google | openai | ollama
ACUITY_SEARCH_LLM_MODE=unconfigured
ACUITY_SEARCH_LLM_BASE_URL=
ACUITY_SEARCH_LLM_API_KEY=
ACUITY_SEARCH_LLM_QUICK_MODEL=
ACUITY_SEARCH_LLM_RESEARCH_MODEL=
ACUITY_SEARCH_LLM_TEMPERATURE=0.2
ACUITY_SEARCH_LLM_MAX_OUTPUT_TOKENS=2000

# Sharing & Guest Session Isolation
ACUITY_SEARCH_SHARE_DEFAULT_EXPIRY_DAYS=30
ACUITY_SEARCH_GUEST_COOKIE_SECRET=acuity-dev-guest-session-secret-change-in-prod
ACUITY_SEARCH_PUBLIC_MULTI_USER=false

# Future Acuity.Codex Bridge (Design-only in MVP; disabled by default)
ACUITY_CODEX_BRIDGE_ENABLED=false
ACUITY_CODEX_EXPORT_SCHEMA_VERSION=acuity.research-bundle.v1

# --- Unified login (Acuity identity provider, auth.acuity.institute) ---
# Register the "search" application in https://auth.acuity.institute/admin.
# Redirect URI: https://search.acuity.institute/api/auth/callback/acuity
# ACUITY_OIDC_ISSUER=https://auth.acuity.institute/api/auth
# ACUITY_OIDC_CLIENT_ID=
# ACUITY_OIDC_CLIENT_SECRET=          # secret: set with `railway variable set --stdin`
# OIDC_PROVIDER_ID=acuity             # default when only ACUITY_OIDC_* is set
# OIDC_IDP_ENFORCES_SIGNUP=true       # invite-only Search accepts new IdP-verified identities
# AUTH_LOCAL_LOGIN_ENABLED=true       # fallback email/password form (keep on during rollout)
